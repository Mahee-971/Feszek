<%- include('partials/header', { pageTitle: 'Apartments — Fészek' }) %>

<a class="back-link" href="/">&larr; All categories</a>

<section class="hero">
  <h1>Find your place in Budapest. No fees, ever.</h1>
  <p>Browse apartments and rooms listed directly by owners. Contact them, go see the place, move in. That's it.</p>
</section>

<form class="filters" method="GET" action="/apartments">
  <select name="district">
    <option value="">All districts</option>
    <% districts.forEach(d => { %>
      <option value="<%= d %>" <%= filters.district === d ? 'selected' : '' %>><%= d %></option>
    <% }) %>
  </select>

  <select name="listingType">
    <option value="">Apartment or room</option>
    <option value="apartment" <%= filters.listingType === 'apartment' ? 'selected' : '' %>>Whole apartment</option>
    <option value="room" <%= filters.listingType === 'room' ? 'selected' : '' %>>Room in shared flat</option>
  </select>

  <input type="number" name="maxPrice" placeholder="Max price (Ft/month)" value="<%= filters.maxPrice || '' %>">
  <input type="number" step="0.5" name="minRooms" placeholder="Min rooms" value="<%= filters.minRooms || '' %>">

  <button type="submit" class="btn btn-primary">Search</button>
  <% if (filters.district || filters.maxPrice || filters.minRooms || filters.listingType) { %>
    <a href="/apartments" class="btn btn-ghost">Clear</a>
  <% } %>
</form>

<p class="result-count"><%= results.length %> listing<%= results.length === 1 ? '' : 's' %> found</p>

<div class="listing-grid">
  <% if (results.length === 0) { %>
    <p class="empty-state">No listings match your filters yet. Try widening your search, or check back soon — new places go up every week.</p>
  <% } %>
  <% results.forEach(listing => { %>
    <a class="listing-card" href="/listing/<%= listing.id %>">
      <div class="card-photo">
        <% if (listing.coverImage) { %>
          <img src="/uploads/photos/<%= listing.coverImage %>" alt="<%= listing.title %>">
        <% } else { %>
          <div class="no-photo">No photo</div>
        <% } %>
        <span class="card-price"><%= listing.price_huf.toLocaleString('en-US') %> Ft<span>/mo</span></span>
      </div>
      <div class="card-body">
        <h3><%= listing.title %></h3>
        <p class="card-meta"><%= listing.district %> · <%= listing.rooms ? listing.rooms + ' room' + (listing.rooms > 1 ? 's' : '') : '' %><%= listing.size_m2 ? ' · ' + listing.size_m2 + ' m²' : '' %></p>
        <p class="card-type"><%= listing.listing_type === 'room' ? 'Room in shared flat' : 'Whole apartment' %></p>
      </div>
    </a>
  <% }) %>
</div>

<%- include('partials/footer') %>
